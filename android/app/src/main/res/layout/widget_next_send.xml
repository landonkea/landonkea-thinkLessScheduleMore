<?xml version="1.0" encoding="utf-8"?>
<!-- ───────────────────────────────────────────────────────────
     widget_next_send.xml — layout for the "Next Message" Home
     Screen widget.

     RemoteViews only supports a limited subset of layouts/views
     (no custom views, no arbitrary attributes) — this stays to
     plain LinearLayout + TextView, which RemoteViews can inflate
     in the launcher's process.
     ─────────────────────────────────────────────────────────── -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#22222B"
    android:padding="12dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next Message"
        android:textColor="#AAAAB8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="No messages scheduled"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_recipient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#AAAAB8"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
