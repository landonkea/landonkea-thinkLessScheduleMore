<?xml version="1.0" encoding="utf-8"?>
<!-- ───────────────────────────────────────────────────────────
     AndroidManifest.xml — tells Android what the app can do
     ───────────────────────────────────────────────────────────
     This XML file is required by every Android app.
     It declares:
       - Permissions (what the app is allowed to do)
       - Activities (screens the user sees)
       - Services (background tasks)
     
     Android reads this at install time.  If we don't declare
     something here, the app can't use it.                     -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ─────────────────────────────────────────
         SEND_SMS: allows the app to send SMS from your SIM card.
                   Android shows this to the user at install time.
                   Without this, SmsManager.sendTextMessage fails.
         
         POST_NOTIFICATIONS: required on Android 13+ to show the
                   persistent notification for our foreground service.
                   Without this, the notification is silently blocked.
         
         FOREGROUND_SERVICE: required on Android 9+ to use
                   startForegroundService().
         
         FOREGROUND_SERVICE_SPECIAL_USE: required on Android 14+
                   because our service type is "specialUse" (sending
                   scheduled SMS doesn't match any built-in type).  -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ── The app itself ──────────────────────────────────────
         `label` = the app name shown under the icon.
         `icon` = the launcher icon (default Android icon).       -->
    <application
        android:label="ThinkLessScheduleMore"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true">

        <!-- ── Main screen ────────────────────────────────────
             This is what opens when the user taps the icon.
             `exported="true"` means other apps can open it
             (needed for the launcher to find it).               -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Background service ─────────────────────────────
             This is our SMS scheduling engine.
             `foregroundServiceType="specialUse"` tells Android
             this service does a legitimate task that doesn't fit
             any built-in type (scheduled SMS sending).
             `exported="false"` = only our app can start it.     -->
        <service
            android:name=".SchedulerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <!-- Required on Android 14+ for specialUse services:
                 explains WHY this type is needed. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="sends scheduled SMS messages to a pre-approved recipient at user-configured random times" />
        </service>

    </application>
</manifest>
