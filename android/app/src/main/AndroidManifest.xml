<?xml version="1.0" encoding="utf-8"?>
<!-- ───────────────────────────────────────────────────────────
     AndroidManifest.xml — tells Android what the app can do
     ───────────────────────────────────────────────────────────
     This XML file is required by every Android app.
     It declares:
       - Permissions (what the app is allowed to do)
       - Activities (screens the user sees)
       - Services (background tasks)
     
     Android reads this at install time.  If we don't declare
     something here, the app can't use it.                     -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ─────────────────────────────────────────
         SEND_SMS: allows the app to send SMS from your SIM card.
                   Android shows this to the user at install time.
                   Without this, SmsManager.sendTextMessage fails.
         
         POST_NOTIFICATIONS: required on Android 13+ to show the
                   persistent notification for our foreground service.
                   Without this, the notification is silently blocked.
         
         FOREGROUND_SERVICE: required on Android 9+ to use
                   startForegroundService().
         
         FOREGROUND_SERVICE_SPECIAL_USE: required on Android 14+
                   because our service type is "specialUse" (sending
                   scheduled SMS doesn't match any built-in type).  -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- RECEIVE_BOOT_COMPLETED: lets BootReceiver hear BOOT_COMPLETED
         so scheduling survives a device restart (see BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- READ_CONTACTS: lets the "Pick Contact" button in MainActivity
         read the selected contact's phone number/name from the
         system Contacts provider. Falls back gracefully to manual
         entry if denied — see MainActivity's contact picker section. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- ── The app itself ──────────────────────────────────────
         `label` = the app name shown under the icon.
         `icon` = the launcher icon (default Android icon).       -->
    <application
        android:name=".ThinkLessApplication"
        android:label="ThinkLessScheduleMore"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true">

        <!-- ── Main screen ────────────────────────────────────
             This is what opens when the user taps the icon.
             `exported="true"` means other apps can open it
             (needed for the launcher to find it).               -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Stats dashboard screen ─────────────────────────
             Launched from MainActivity's "📊 Stats" button.
             `exported="false"` — only reachable from within the app. -->
        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:label="Stats" />

        <!-- ── Background service ─────────────────────────────
             This is our SMS scheduling engine.
             `foregroundServiceType="specialUse"` tells Android
             this service does a legitimate task that doesn't fit
             any built-in type (scheduled SMS sending).
             `exported="false"` = only our app can start it.     -->
        <service
            android:name=".SchedulerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <!-- Required on Android 14+ for specialUse services:
                 explains WHY this type is needed. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="sends scheduled SMS messages to a pre-approved recipient at user-configured random times" />
        </service>

        <!-- ── Boot receiver ───────────────────────────────────
             Restarts SchedulerService after a reboot (or app
             update, via MY_PACKAGE_REPLACED) so scheduling doesn't
             silently die. `exported="true"` is required for the
             system to deliver BOOT_COMPLETED to it. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ── Home Screen widget: "Next Message" ──────────────
             Shows the next scheduled send time/recipient (see
             NextSendWidgetProvider.kt). `exported="true"` is
             required — the launcher (a different app/process)
             needs to be able to deliver widget lifecycle broadcasts
             (update/enable/disable/etc.) to this receiver. -->
        <receiver
            android:name=".NextSendWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_send_widget_info" />
        </receiver>

        <!-- ── Tasker / Locale plugin: EDIT_SETTING ────────────
             Tasker launches this Activity (for a result) when the
             user adds or edits one of this app's automation actions
             inside their own Task — see TaskerEditActivity.
             `exported="true"` is required so Tasker (a different
             app/process) can launch it. The <meta-data> line is part
             of the standard plugin contract too, though not
             functionally required by Tasker itself — it's how the
             Locale app (the contract's original definer) discovers
             plugin activities. -->
        <activity
            android:name=".TaskerEditActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Automation Action">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <!-- ── Tasker / Locale plugin: FIRE_SETTING ─────────────
             Tasker sends this broadcast when a Task containing a
             configured action from this app actually runs — see
             TaskerFireReceiver. `exported="true"` is required so
             Tasker can deliver it; the receiver itself validates the
             bundle contents before acting on anything (see that
             class), so accepting broadcasts from other apps is safe. -->
        <receiver
            android:name=".TaskerFireReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
